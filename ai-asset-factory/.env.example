# =====================
# Server Configuration
# =====================
PORT=3000
NODE_ENV=development

# Backend base URL (for generating absolute file URLs)
# Set this to your Render/production URL
BASE_URL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# =====================
# AI API Keys
# =====================
# 阿里云百炼 API Key (for Qwen-VL + 万相2.7)
DASHSCOPE_API_KEY=your-dashscope-api-key

# 可灵 AI API Key (for video generation)
KLING_API_KEY=your-kling-api-key

# =====================
# Database
# =====================
DB_PATH=./data/app.db

# =====================
# File Storage
# =====================
UPLOAD_DIR=./uploads
